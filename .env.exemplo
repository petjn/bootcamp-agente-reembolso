# Copie para .env e preencha. O .env nunca sobe para o repositório.

# Servidor MCP da operadora (cadastro e histórico dos beneficiários)
MCP_OPERADORA_URL=http://localhost:9000/mcp
MCP_OPERADORA_TOKEN=treino

# Observabilidade (opcional). Sem a chave, o agente roda normalmente.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-reembolso

# Dia da conversa nos casos de treino (prazo do art. 12). Apague para usar a data real.
DATA_REFERENCIA=2026-05-20

# Opcionais: modelo e endereço do Ollama (padrões em app/llm.py)
# OLLAMA_BASE_URL=http://localhost:11434
# MODELO_CHAT=gemma4:e4b-it-qat
# MODELO_EMBEDDING=embeddinggemma:300m
