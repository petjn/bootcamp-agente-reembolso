# ---------------------------------------------------------------- segredos
# chaves do LangSmith e configuração local: nunca sobem
.env
.env.*
!.env.exemplo

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------- LangGraph Studio
# banco local do `langgraph dev` (conversas gravadas, ~190 MB)
.langgraph_api/

# ---------------------------------------------------------------- saídas das rodadas
# Traces, históricos e logs de cada rodada (~1,5 GB) ficam só na máquina.
# Sobem os relatórios em Markdown (resultado.md de cada rodada, decisões,
# análises) e a tabela de evolução em CSV.
docs/**/*.json
docs/**/*.jsonl
docs/**/*.log
docs/**/*.err
docs/**/*.txt
# log local de chamadas ao modelo (LOG_LLM)
*.log

# ---------------------------------------------------------------- material da banca
# enunciado da prova e notebooks de referência do curso
instrucoes_da_prova.pdf
referencia/

# ---------------------------------------------------------------- fora do repositório (ficam só no PC)
# casos que não são mais usados, notebook inacabado e configuração do LangGraph Studio
casos_arquivados/
notebook/
langgraph.json
langgraph.traces.json
studio.py

# scripts: só os evals por componente
scripts/*
